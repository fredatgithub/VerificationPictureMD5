<Window x:Class="VerificationPictureMD5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:VerificationPictureMD5"
        mc:Ignorable="d"
        Title="Verification Picture MD5" 
        Height="600" 
        Width="800"
        WindowStartupLocation="Manual">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Directory selection row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="DirectoryTextBox" 
                     Width="400" 
                     Height="30" 
                     VerticalContentAlignment="Center"
                     Text="{Binding LastDirectory, UpdateSourceTrigger=PropertyChanged}"/>
            <Button x:Name="BrowseButton" 
                    Content="Browse..." 
                    Width="80" 
                    Height="30" 
                    Margin="5,0,5,0"
                    Click="BrowseButton_Click"/>
            <Button x:Name="LoadImagesButton" 
                    Content="Load Images" 
                    Width="100" 
                    Height="30"
                    Click="LoadImagesButton_Click"/>
        </StackPanel>
        
        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            
            <!-- DataGrid for images -->
            <DataGrid x:Name="ImagesDataGrid" 
                      Grid.Column="0"
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionChanged="ImagesDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn 
                        Header="Image Path" 
                        Binding="{Binding Path}" 
                        Width="*" 
                        IsReadOnly="True"/>
                    <DataGridTextColumn 
                        Header="MD5 Hash" 
                        Binding="{Binding MD5Hash}" 
                        Width="120" 
                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- GridSplitter -->
            <GridSplitter x:Name="MainGridSplitter"
                          Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="LightGray"
                          ShowsPreview="True"
                          DragCompleted="MainGridSplitter_DragCompleted"/>
            
            <!-- Image preview -->
            <Border Grid.Column="2" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="LightGray">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <Image x:Name="PreviewImage" 
                           Stretch="UniformToFill"
                           Margin="0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

